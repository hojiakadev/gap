# Netlify: set in the Netlify UI, then redeploy after changes.
# Leave unset locally to use the Vite Socket.IO proxy.
# VITE_RELAY_URL=https://your-relay.onrender.com

# Render: set to the EXACT Netlify origin (no path). Multiple origins: comma separated.
# ALLOWED_ORIGINS=https://your-site.netlify.app
# NODE_ENV=production
# SERVE_CLIENT=false
# Render supplies PORT automatically; local default is 3001.
PORT=3001
