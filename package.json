{
  "name": "gap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n relay,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && npm run build:web && npm run build:relay",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "vite build",
    "build:relay": "tsup server/index.ts --format esm --platform node --out-dir dist-server --clean",
    "ci": "npm run format:check && npm test && npm run build",
    "build:netlify": "node scripts/validate-netlify.mjs && npm run ci",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:local": "node scripts/verify-local-deployment.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "i18next": "^26.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
